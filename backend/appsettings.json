{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenRouter": {
    "Enabled": false,
    "Models": [],
    "TimeoutSeconds": 45,
    "MaxOutputTokens": 1200,
    "MaxPromptBytes": 32000,
