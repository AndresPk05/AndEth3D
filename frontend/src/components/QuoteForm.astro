  <section id="solicitar" class="max-w-2xl mx-auto px-4 py-14">
    <div class="text-center mb-10">
      <h2 class="font-display text-4xl font-extrabold mb-3">Solicita tu cotización</h2>
      <p class="text-ink-soft">Revisa tu idea y dinos cómo contactarte. Te responderemos con el precio.</p>
    </div>

    <div id="quote-box" class="bg-white rounded-3xl border border-brand-100 shadow-xl shadow-brand-100 p-4 sm:p-8">
      <button id="use-design-brief" hidden type="button" disabled class="mb-5 text-sm text-brand-700 underline disabled:opacity-50">Copiar mi diseño</button>
      <form id="quote-form" class="space-y-5">
        <fieldset id="guest-contact" class="space-y-4">
          <legend class="font-semibold mb-2">Cotiza sin crear una cuenta</legend>
          <p class="text-sm text-ink-soft">Déjanos tus datos para responder a tu solicitud.</p>
          <div><label for="contact-name" class="block text-sm font-semibold mb-1">Nombre *</label>
            <input id="contact-name" autocomplete="name" required maxlength="100" class="w-full px-4 py-3 rounded-xl border border-brand-200" /></div>
          <div><label for="contact-email" class="block text-sm font-semibold mb-1">Correo electrónico *</label>
            <input id="contact-email" type="email" autocomplete="email" required maxlength="254" class="w-full px-4 py-3 rounded-xl border border-brand-200" /></div>
        </fieldset>
        <div>
          <label for="description" class="block text-sm font-semibold mb-1">Describe tu idea *</label>
          <textarea id="description" required maxlength="5000" rows="5"
            placeholder="Ej: Quiero un llavero con el logo de mi empresa, unas 50 unidades en color morado…"
            class="w-full px-4 py-3 rounded-xl border border-brand-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 outline-none transition resize-y"></textarea>
        </div>
        <div class="rounded-2xl border-2 border-dashed border-brand-300 bg-brand-50 p-4 sm:p-5">
          <label for="reference" class="block font-semibold text-brand-700 mb-2">Archivo de referencia <span class="font-normal text-sm">(opcional)</span></label>
          <p id="reference-help" class="text-sm text-ink-soft mb-4">Adjunta una foto, un dibujo o un modelo 3D para ayudarnos a entender tu idea.</p>
          <input id="reference" type="file" accept=".png,.jpg,.jpeg,.webp,.stl,.obj,.3mf,.pdf,.zip" aria-describedby="reference-help file-help"
            class="block w-full min-w-0 text-sm text-ink file:mr-3 file:px-4 file:py-3 file:rounded-full file:border-0 file:bg-brand-600 file:text-white file:font-semibold hover:file:bg-brand-700 file:cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600" />
          <p id="file-help" class="text-xs text-ink-soft mt-3">Imagen, STL, OBJ, 3MF, PDF o ZIP. Máx. 5 MB sin iniciar sesión.</p>
        </div>
        <p id="error" class="hidden text-sm text-red-600 font-medium"></p>
        <button type="submit" id="submit-btn"
          class="w-full py-3.5 rounded-full bg-brand-600 text-white font-bold hover:bg-brand-700 shadow-md shadow-brand-200 transition">
          Enviar cotización
        </button>
      </form>
    </div>

    <div id="success-box" class="hidden bg-white rounded-3xl border border-brand-100 shadow-xl shadow-brand-100 p-5 sm:p-10 text-center">
      <div class="w-16 h-16 mx-auto rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-3xl mb-4">✓</div>
      <h2 class="font-display text-2xl font-bold mb-2">Cotización enviada</h2>
      <p class="text-ink-soft mb-6">Recibimos tu solicitud. Te contactaremos pronto con el precio y el tiempo estimado.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a id="my-orders" href="/pedidos" class="hidden px-5 py-2.5 rounded-full bg-brand-600 text-white font-semibold hover:bg-brand-700 transition">Ver mis pedidos</a>
        <a href="/galeria" class="px-5 py-2.5 rounded-full border-2 border-brand-200 text-brand-700 font-semibold hover:bg-brand-50 transition">Seguir explorando</a>
      </div>
    </div>


  </section>

  <script>
    import { apiFetch, getSession } from "../lib/api";

    const guestFields = document.getElementById("guest-contact") as HTMLFieldSetElement;
    function syncSession() {
      const signedIn = Boolean(getSession());
      guestFields.disabled = signedIn;
      guestFields.classList.toggle("hidden", signedIn);
      document.getElementById("file-help")!.textContent = `Imagen, STL, OBJ, 3MF, PDF o ZIP. Máx. ${signedIn ? 20 : 5} MB.`;
      return signedIn;
    }
    syncSession();

    let latestBrief = "";
    const useBrief = document.getElementById("use-design-brief") as HTMLButtonElement;
    document.addEventListener("design:brief", event => {
      latestBrief = (event as CustomEvent<{text: string}>).detail.text;
      useBrief.disabled = !latestBrief;
      useBrief.hidden = !latestBrief;
    });
    document.getElementById("quote-design")?.addEventListener("click", () => {
      if (latestBrief) useBrief.click();
    });
    useBrief.addEventListener("click", () => {
      const description = document.getElementById("description") as HTMLTextAreaElement;
      if (description.value.trim() && description.value !== latestBrief.slice(0, 5000) && !confirm("¿Reemplazar la descripción por la ficha actual del asistente?")) return;
      description.value = latestBrief.slice(0, 5000);
      description.focus();
    });
    const form = document.getElementById("quote-form") as HTMLFormElement;
    const error = document.getElementById("error")!;
    const btn = document.getElementById("submit-btn") as HTMLButtonElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error.classList.add("hidden");

      const signedIn = syncSession();
      if (!form.reportValidity()) return;
      const maxBytes = signedIn ? 20_000_000 : 5_000_000;
      const fileInput = document.getElementById("reference") as HTMLInputElement;
      if (fileInput.files?.[0] && fileInput.files[0].size > maxBytes) {
        error.textContent = `El archivo supera los ${maxBytes / 1_000_000} MB permitidos.`;
        error.classList.remove("hidden");
        return;
      }

      btn.disabled = true;
      btn.textContent = "Enviando…";
      try {
        const data = new FormData();
        data.append("description", (document.getElementById("description") as HTMLTextAreaElement).value);
        data.append("material", "No estoy seguro");
        if (fileInput.files?.[0]) data.append("referenceFile", fileInput.files[0]);

        if (!signedIn) {
          data.append("contactName", (document.getElementById("contact-name") as HTMLInputElement).value.trim());
          data.append("contactEmail", (document.getElementById("contact-email") as HTMLInputElement).value.trim());
        }
        await apiFetch(signedIn ? "/api/quotes" : "/api/quotes/guest", { method: "POST", body: data });
        document.getElementById("my-orders")!.classList.toggle("hidden", !signedIn);
        document.getElementById("quote-box")!.classList.add("hidden");
        document.getElementById("success-box")!.classList.remove("hidden");
      } catch (err) {
        error.textContent = (err as Error).message;
        error.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = "Enviar cotización";
      }
    });
  </script>
