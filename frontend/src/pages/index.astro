---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    title: "Figuras y decoración",
    text: "Personajes, macetas, lámparas y piezas únicas para tu espacio.",
    span: "md:col-span-7",
    icon: `<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/><path d="M3 17.5l9 5 9-5"/>`,
  },
  {
    title: "Regalos personalizados",
    text: "Llaveros, nombres y logos que sorprenden.",
    span: "md:col-span-5",
    icon: `<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M5 12v9h14v-9"/><path d="M12 8s-1.5-4-4-4-2.5 4 0 4h4zm0 0s1.5-4 4-4 2.5 4 0 4h-4z"/>`,
  },
  {
    title: "Repuestos y piezas",
    text: "Piezas funcionales y repuestos difíciles de conseguir.",
    span: "md:col-span-5",
    icon: `<circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1"/>`,
  },
  {
    title: "Prototipos",
    text: "Valida tu producto o emprendimiento con prototipos rápidos.",
    span: "md:col-span-7",
    icon: `<path d="M12 19l7-7a4.95 4.95 0 00-7-7l-7 7-2 7 7-2z"/><path d="M15 6l3 3"/><path d="M5 15l4 4"/>`,
  },
];

const steps = [
  ["Cuéntanos tu idea", "Describe qué quieres imprimir y adjunta referencias si las tienes."],
  ["Recibe tu cotización", "Te respondemos con precio y tiempo estimado en menos de 24 horas."],
  ["Imprimimos tu pieza", "Puedes ver el estado de tu pedido en todo momento."],
  ["Recíbelo y disfruta", "Coordinamos la entrega y tu pieza llega lista para usar."],
];
---

<Layout title="Impresión 3D personalizada">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-brand-200/50 rounded-full blur-3xl"></div>
    <div class="absolute top-40 -left-40 w-[420px] h-[420px] bg-brand-100/80 rounded-full blur-3xl"></div>

    <div class="relative max-w-6xl mx-auto px-4 pt-20 pb-24 grid md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-7">
        <span class="reveal inline-block px-4 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-sm font-semibold mb-7">
          Impresión 3D bajo pedido
        </span>
        <h1 class="reveal font-display text-5xl md:text-6xl lg:text-7xl font-extrabold leading-[1.05] tracking-tight mb-6" style="--reveal-delay: 80ms">
          Tus ideas, impresas
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-700 to-brand-400">capa por capa</span>
        </h1>
        <p class="reveal text-lg text-ink-soft leading-relaxed mb-9 max-w-[34rem]" style="--reveal-delay: 160ms">
          Figuras, prototipos, repuestos y regalos personalizados con acabado profesional.
          Cuéntanos tu idea y te cotizamos sin compromiso.
        </p>
        <div class="reveal flex flex-wrap gap-3" style="--reveal-delay: 240ms">
          <a href="/crear" class="px-6 py-3 rounded-full bg-brand-600 text-white font-semibold hover:bg-brand-700 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] shadow-lg shadow-brand-300/60 transition">
            Cotiza tu idea gratis
          </a>
          <a href="/galeria" class="px-6 py-3 rounded-full text-brand-700 font-semibold underline decoration-brand-300 decoration-2 underline-offset-4 hover:decoration-brand-600 transition">
            Ver trabajos realizados
          </a>
        </div>
        <dl class="reveal flex flex-wrap gap-x-8 gap-y-3 mt-10 text-sm" style="--reveal-delay: 320ms">
          <div>
            <dt class="font-display font-bold text-2xl text-brand-700 tnum">24 h</dt>
            <dd class="text-ink-soft">respuesta a tu cotización</dd>
          </div>
          <div>
            <dt class="font-display font-bold text-2xl text-brand-700 tnum">6+</dt>
            <dd class="text-ink-soft">materiales disponibles</dd>
          </div>
          <div>
            <dt class="font-display font-bold text-2xl text-brand-700 tnum">100%</dt>
            <dd class="text-ink-soft">diseños personalizados</dd>
          </div>
        </dl>
      </div>

      <div class="md:col-span-5 relative flex justify-center md:justify-end">
        <div class="absolute inset-0 bg-gradient-to-tr from-brand-400/30 to-brand-200/40 rounded-[2.5rem] rotate-3 scale-105"></div>
        <div class="relative bg-ink rounded-[2.5rem] p-8 shadow-2xl shadow-brand-300/50 -rotate-2 hover:rotate-0 transition-transform duration-500">
          <img src="/logo.png" alt="Mascota de AndEth3D: un zorro morado con una boquilla de impresora 3D" class="w-60 md:w-72 drop-shadow-2xl" />
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="max-w-6xl mx-auto px-4 py-20">
    <div class="mb-12 reveal max-w-xl">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-3">Qué podemos imprimir para ti</h2>
      <p class="text-ink-soft">Desde una idea en papel hasta el objeto en tus manos.</p>
    </div>
    <div class="grid md:grid-cols-12 gap-5">
      {services.map((service, i) => (
        <article
          class={`reveal group p-7 rounded-3xl bg-brand-50 hover:bg-brand-100/70 transition-colors ${service.span}`}
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <div class="w-11 h-11 rounded-2xl bg-white text-brand-600 flex items-center justify-center mb-5 shadow-sm shadow-brand-200 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={service.icon} />
          </div>
          <h3 class="font-display font-bold text-lg mb-2">{service.title}</h3>
          <p class="text-sm text-ink-soft leading-relaxed max-w-md">{service.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Galería destacada -->
  <section class="bg-brand-50/70 border-y border-brand-100 py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-end justify-between gap-6 mb-10 reveal">
        <div class="max-w-lg">
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-2">Trabajos que ya imprimimos</h2>
          <p class="text-ink-soft">Piezas reales hechas para nuestros clientes.</p>
        </div>
        <a href="/galeria" class="hidden sm:inline-block text-brand-700 font-semibold underline decoration-brand-300 decoration-2 underline-offset-4 hover:decoration-brand-600 transition whitespace-nowrap">Ver toda la galería</a>
      </div>
      <div id="featured-gallery" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[0, 1, 2].map(() => (
          <div class="rounded-3xl overflow-hidden">
            <div class="skeleton aspect-[4/3]"></div>
            <div class="pt-4 space-y-2">
              <div class="skeleton h-3 w-20 rounded-full"></div>
              <div class="skeleton h-4 w-3/4 rounded-full"></div>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-8 sm:hidden">
        <a href="/galeria" class="text-brand-700 font-semibold underline decoration-brand-300 decoration-2 underline-offset-4">Ver toda la galería</a>
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="max-w-6xl mx-auto px-4 py-20">
    <div class="mb-12 reveal max-w-xl">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-3">Así de fácil es pedir</h2>
      <p class="text-ink-soft">En cuatro pasos tu idea se vuelve realidad.</p>
    </div>
    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-5 gap-y-10">
      {steps.map(([title, text], i) => (
        <li class="reveal relative pl-1" style={`--reveal-delay: ${i * 90}ms`}>
          <span class="font-display text-6xl font-extrabold text-brand-200 leading-none tnum">{i + 1}</span>
          <h3 class="font-display font-bold mt-3 mb-2">{title}</h3>
          <p class="text-sm text-ink-soft leading-relaxed">{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- CTA final -->
  <section class="max-w-6xl mx-auto px-4 pb-24">
    <div class="reveal relative overflow-hidden rounded-[2.5rem] text-white px-8 py-16 md:py-20 text-center shadow-2xl shadow-brand-300/50"
      style="background: radial-gradient(120% 140% at 15% 0%, #8b5cf6 0%, transparent 55%), radial-gradient(100% 120% at 90% 100%, #a378f0 0%, transparent 50%), linear-gradient(160deg, #6828d4 0%, #471d8a 100%);">
      <div class="absolute -top-20 -right-20 w-72 h-72 bg-white/10 rounded-full blur-3xl"></div>
      <div class="relative">
        <h2 class="font-display text-3xl md:text-5xl font-extrabold mb-4">¿Listo para imprimir tu idea?</h2>
        <p class="text-brand-100 max-w-xl mx-auto mb-9 leading-relaxed">
          Cotizar es gratis y sin compromiso. Cuéntanos qué tienes en mente y te respondemos rápido.
        </p>
        <a href="/crear" class="inline-block px-8 py-3.5 rounded-full bg-white text-brand-700 font-bold hover:bg-brand-50 hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] shadow-lg transition">
          Cotizar ahora
        </a>
      </div>
    </div>
  </section>

  <script>
    import { escapeHtml, apiFetch, fileUrl } from "../lib/api";

    interface GalleryItem {
      id: number;
      title: string;
      description: string;
      category: string;
      material: string;
      imageUrl: string;
    }

    const container = document.getElementById("featured-gallery")!;

    function placeholderCard(item: GalleryItem) {
      return `
        <article class="group bg-white rounded-3xl overflow-hidden hover:shadow-xl hover:shadow-brand-200/60 hover:-translate-y-1 transition duration-300">
          <div class="aspect-[4/3] bg-gradient-to-br from-brand-100 to-brand-200 flex items-center justify-center text-brand-400">
            <svg class="w-14 h-14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <div class="p-5">
            <span class="text-xs font-semibold text-brand-600 uppercase tracking-wider">${escapeHtml(item.category)}</span>
            <h3 class="font-display font-bold mt-1">${escapeHtml(item.title)}</h3>
            <p class="text-sm text-ink-soft mt-1 line-clamp-2">${escapeHtml(item.description)}</p>
          </div>
        </article>`;
    }

    try {
      const items = await apiFetch<GalleryItem[]>("/api/gallery");
      const featured = items.slice(0, 6);
      container.innerHTML = featured.length
        ? featured
            .map((item) =>
              item.imageUrl
                ? `
              <article class="group bg-white rounded-3xl overflow-hidden hover:shadow-xl hover:shadow-brand-200/60 hover:-translate-y-1 transition duration-300">
                <div class="aspect-[4/3] overflow-hidden bg-brand-50">
                  <img src="${fileUrl(item.imageUrl)}" alt="${escapeHtml(item.title)}" loading="lazy"
                       class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                </div>
                <div class="p-5">
                  <span class="text-xs font-semibold text-brand-600 uppercase tracking-wider">${escapeHtml(item.category)}</span>
                  <h3 class="font-display font-bold mt-1">${escapeHtml(item.title)}</h3>
                  <p class="text-sm text-ink-soft mt-1 line-clamp-2">${escapeHtml(item.description)}</p>
                </div>
              </article>`
                : placeholderCard(item)
            )
            .join("")
        : `<p class="text-ink-soft col-span-full">Pronto publicaremos nuestros trabajos aquí.</p>`;
    } catch {
      container.innerHTML = `<p class="text-ink-soft col-span-full">No pudimos cargar la galería. Inténtalo de nuevo más tarde.</p>`;
    }
  </script>
</Layout>
