---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Detalle de cotización de diseño">
  <section class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-4">Tu solicitud de diseño</h1>
    <p id="design-quote-status" role="status" aria-live="polite">Cargando.</p>
    <div class="grid md:grid-cols-2 gap-6 my-5">
      <div><img id="design-quote-image" alt="Propuesta conceptual enviada para cotización" class="hidden w-full rounded-xl" /><p class="text-sm mt-3">Imagen conceptual; requiere validación técnica.</p></div>
      <pre id="design-quote-summary" class="whitespace-pre-wrap font-sans text-sm"></pre>
    </div>
    <h2 class="font-bold text-xl mb-3">Requisitos enviados</h2>
    <pre id="design-quote-brief" class="whitespace-pre-wrap font-sans text-sm mb-5"></pre>
    <details class="border rounded-xl p-4"><summary>Conversación al enviar la solicitud</summary><div id="design-quote-turns" class="space-y-3 mt-4"></div></details>
    <form id="design-quote-review" class="hidden border rounded-xl p-5 mt-6 space-y-4">
      <h2 class="font-bold text-xl">Revisión administrativa</h2>
      <p>Confirma viabilidad, complejidad, consumo, plazo, impuestos y envío antes de comunicar el precio final.</p>
      <label class="block">Precio total confirmado (COP)<input name="priceCop" required type="number" min="0.01" max="9999999999.99" step="0.01" class="block border rounded p-2" /></label>
      <label class="block">Condiciones y respuesta al cliente<textarea name="notes" required minlength="3" maxlength="5000" rows="4" class="block w-full border rounded p-2"></textarea></label>
      <button class="rounded-full bg-brand-600 text-white px-5 py-2">Confirmar cotización</button>
      <a href="/admin/cotizaciones" class="block underline">Volver al panel para convertir en pedido</a>
    </form>
  </section>
  <script>import "../lib/design-quote";</script>
</Layout>
