---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Galería" description="Trabajos de impresión 3D realizados por AndEth3D. Inspírate y cotiza tu propia pieza.">
  <section class="max-w-6xl mx-auto px-4 py-14">
    <div class="text-center mb-10">
      <h1 class="font-display text-4xl font-extrabold mb-3">Nuestra galería</h1>
      <p class="text-ink-soft max-w-xl mx-auto">
        Piezas reales que ya imprimimos para nuestros clientes. ¿Te imaginas la tuya aquí?
        <a href="/cotizar" class="text-brand-700 font-semibold hover:underline">Cotízala</a>.
      </p>
    </div>

    <div id="category-filters" class="flex flex-wrap justify-center gap-2 mb-10"></div>

    <div id="gallery-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {[0, 1, 2, 3, 4, 5].map(() => (
        <div class="rounded-3xl overflow-hidden">
          <div class="skeleton aspect-[4/3]"></div>
          <div class="pt-4 space-y-2">
            <div class="skeleton h-3 w-20 rounded-full"></div>
            <div class="skeleton h-4 w-3/4 rounded-full"></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Modal detalle -->
  <div id="detail-modal" class="hidden fixed inset-0 z-50 bg-ink/60 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl">
      <div class="relative">
        <img id="modal-image" src="" alt="" class="w-full aspect-[4/3] object-cover bg-brand-50" />
        <button id="modal-close" class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 text-ink font-bold hover:bg-white shadow">✕</button>
      </div>
      <div class="p-6">
        <span id="modal-category" class="text-xs font-semibold text-brand-600 uppercase tracking-wide"></span>
        <h3 id="modal-title" class="font-display text-2xl font-bold mt-1"></h3>
        <p id="modal-description" class="text-ink-soft mt-2"></p>
        <p id="modal-material" class="text-sm mt-3"><span class="font-semibold">Material:</span> <span></span></p>
        <a href="/cotizar" class="mt-5 inline-block px-6 py-2.5 rounded-full bg-brand-600 text-white font-semibold hover:bg-brand-700 transition">
          Quiero algo así
        </a>
      </div>
    </div>
  </div>

  <script>
    import { apiFetch, fileUrl } from "../lib/api";

    interface GalleryItem {
      id: number;
      title: string;
      description: string;
      category: string;
      material: string;
      imageUrl: string;
    }

    const grid = document.getElementById("gallery-grid")!;
    const filters = document.getElementById("category-filters")!;
    const modal = document.getElementById("detail-modal")!;

    let items: GalleryItem[] = [];
    let activeCategory = "Todas";

    function cardImage(item: GalleryItem) {
      return item.imageUrl
        ? `<img src="${fileUrl(item.imageUrl)}" alt="${item.title}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />`
        : `<div class="w-full h-full bg-gradient-to-br from-brand-100 to-brand-200 flex items-center justify-center text-brand-400">
             <svg class="w-14 h-14" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
             </svg>
           </div>`;
    }

    function render() {
      const visible = activeCategory === "Todas" ? items : items.filter((i) => i.category === activeCategory);
      grid.innerHTML = visible.length
        ? visible
            .map(
              (item) => `
          <button data-id="${item.id}" class="gallery-card group text-left bg-white rounded-2xl overflow-hidden border border-brand-100 hover:shadow-xl hover:shadow-brand-100 hover:border-brand-300 transition">
            <div class="aspect-[4/3] overflow-hidden bg-brand-50">${cardImage(item)}</div>
            <div class="p-5">
              <span class="text-xs font-semibold text-brand-600 uppercase tracking-wide">${item.category}</span>
              <h3 class="font-display font-bold mt-1">${item.title}</h3>
              <p class="text-sm text-ink-soft mt-1 line-clamp-2">${item.description}</p>
            </div>
          </button>`
            )
            .join("")
        : `<p class="text-ink-soft col-span-full text-center">No hay trabajos en esta categoría todavía.</p>`;

      grid.querySelectorAll(".gallery-card").forEach((card) =>
        card.addEventListener("click", () => openModal(Number((card as HTMLElement).dataset.id)))
      );
    }

    function renderFilters() {
      const categories = ["Todas", ...new Set(items.map((i) => i.category).filter(Boolean))];
      filters.innerHTML = categories
        .map(
          (cat) => `
        <button data-cat="${cat}" class="filter-btn px-4 py-2 rounded-full text-sm font-semibold border transition ${
            cat === activeCategory
              ? "bg-brand-600 text-white border-brand-600"
              : "bg-white text-brand-700 border-brand-200 hover:bg-brand-50"
          }">${cat}</button>`
        )
        .join("");
      filters.querySelectorAll(".filter-btn").forEach((btn) =>
        btn.addEventListener("click", () => {
          activeCategory = (btn as HTMLElement).dataset.cat!;
          renderFilters();
          render();
        })
      );
    }

    function openModal(id: number) {
      const item = items.find((i) => i.id === id);
      if (!item) return;
      const img = document.getElementById("modal-image") as HTMLImageElement;
      img.src = fileUrl(item.imageUrl);
      img.style.display = item.imageUrl ? "block" : "none";
      document.getElementById("modal-category")!.textContent = item.category;
      document.getElementById("modal-title")!.textContent = item.title;
      document.getElementById("modal-description")!.textContent = item.description;
      document.querySelector("#modal-material span")!.textContent = item.material || "—";
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    function closeModal() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    document.getElementById("modal-close")!.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => e.target === modal && closeModal());
    document.addEventListener("keydown", (e) => e.key === "Escape" && closeModal());

    try {
      items = await apiFetch<GalleryItem[]>("/api/gallery");
      renderFilters();
      render();
      if (!items.length)
        grid.innerHTML = `<p class="text-ink-soft col-span-full text-center">Pronto publicaremos nuestros trabajos aquí.</p>`;
    } catch {
      grid.innerHTML = `<p class="text-ink-soft col-span-full text-center">No pudimos cargar la galería. Inténtalo de nuevo más tarde.</p>`;
    }
  </script>
</Layout>
