---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <span class="inline-block w-24 h-24 rounded-3xl overflow-hidden bg-ink shadow-lg shadow-brand-200 mb-8">
      <img src="/logo.png" alt="AndEth3D" class="w-full h-full object-cover" />
    </span>
    <p class="font-display text-7xl font-extrabold text-brand-200 tnum mb-2">404</p>
    <h1 class="font-display text-3xl font-bold mb-3">Esta capa no se imprimió</h1>
    <p class="text-ink-soft mb-9 max-w-md mx-auto leading-relaxed">
      La página que buscas no existe o fue movida. Vuelve al inicio o inspírate con nuestros trabajos.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="px-6 py-3 rounded-full bg-brand-600 text-white font-semibold hover:bg-brand-700 hover:-translate-y-0.5 active:scale-[0.98] shadow-md shadow-brand-300/60 transition">
        Volver al inicio
      </a>
      <a href="/galeria" class="px-6 py-3 rounded-full text-brand-700 font-semibold underline decoration-brand-300 decoration-2 underline-offset-4 hover:decoration-brand-600 transition">
        Ver la galería
      </a>
    </div>
  </section>
</Layout>
