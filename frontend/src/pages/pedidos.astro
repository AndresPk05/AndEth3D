---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mis pedidos">
  <section class="max-w-4xl mx-auto px-4 py-14">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h1 class="font-display text-4xl font-extrabold mb-2">Mis pedidos</h1>
        <p class="text-ink-soft">Sigue el estado de tus impresiones en tiempo real.</p>
      </div>
      <a href="/cotizar" class="hidden sm:inline-block px-5 py-2.5 rounded-full bg-brand-600 text-white font-semibold hover:bg-brand-700 shadow-md shadow-brand-200 transition">
        Nueva cotización
      </a>
    </div>

    <h2 class="font-display text-xl font-bold mb-4">Pedidos</h2>
    <div id="orders-list" class="space-y-5 mb-12">
      <div class="skeleton h-36 rounded-2xl"></div>
      <div class="skeleton h-36 rounded-2xl"></div>
    </div>

    <h2 class="font-display text-xl font-bold mb-4">Mis cotizaciones</h2>
    <div id="quotes-list" class="space-y-4">
      <div class="skeleton h-20 rounded-2xl"></div>
    </div>
  </section>

  <script>
    import { escapeHtml, apiFetch, getSession } from "../lib/api";

    if (!getSession()) window.location.href = "/login";

    interface Order {
      id: number;
      title: string;
      description: string;
      price: number | null;
      status: string;
      notes: string | null;
      createdAt: string;
      updatedAt: string;
    }

    interface Quote {
      fromDesign: boolean;
      confirmedPriceCop: number | null;
      id: number;
      description: string;
      material: string;
      status: string;
      adminNotes: string | null;
      createdAt: string;
    }

    const STEPS = ["Pending", "InQueue", "Printing", "Finished", "Delivered"];
    const STEP_LABELS: Record<string, string> = {
      Pending: "Recibido",
      InQueue: "En cola",
      Printing: "Imprimiendo",
      Finished: "Terminado",
      Delivered: "Entregado",
      Cancelled: "Cancelado",
    };
    const QUOTE_LABELS: Record<string, string> = {
      Pending: "Pendiente",
      Quoted: "Cotizada",
      Converted: "En pedido",
      Rejected: "Rechazada",
    };
    const QUOTE_COLORS: Record<string, string> = {
      Pending: "bg-amber-100 text-amber-800",
      Quoted: "bg-blue-100 text-blue-800",
      Converted: "bg-green-100 text-green-800",
      Rejected: "bg-red-100 text-red-700",
    };

    function formatDate(iso: string) {
      return new Date(iso).toLocaleDateString("es", { day: "numeric", month: "short", year: "numeric" });
    }

    function stepper(status: string) {
      if (status === "Cancelled")
        return `<span class="inline-block px-3 py-1 rounded-full bg-red-100 text-red-700 text-sm font-semibold">Cancelado</span>`;
      const current = STEPS.indexOf(status);
      return `
        <div class="flex items-center mt-4">
          ${STEPS.map((step, i) => `
            <div class="flex items-center ${i < STEPS.length - 1 ? "flex-1" : ""}">
              <div class="flex flex-col items-center">
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${
                  i <= current ? "bg-brand-600 text-white" : "bg-brand-100 text-brand-400"
                }">${i < current ? "✓" : i + 1}</div>
                <span class="text-[11px] mt-1 whitespace-nowrap ${i <= current ? "text-brand-700 font-semibold" : "text-ink-soft"}">${STEP_LABELS[step]}</span>
              </div>
              ${i < STEPS.length - 1 ? `<div class="flex-1 h-1 mx-1 rounded ${i < current ? "bg-brand-600" : "bg-brand-100"}"></div>` : ""}
            </div>`).join("")}
        </div>`;
    }

    function orderCard(o: Order) {
      return `
        <article class="bg-white rounded-2xl border border-brand-100 shadow-sm p-6">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <h3 class="font-display font-bold text-lg">${escapeHtml(o.title)}</h3>
              <p class="text-sm text-ink-soft mt-1">${escapeHtml(o.description)}</p>
            </div>
            <div class="text-right">
              ${o.price != null ? `<p class="font-display font-bold text-brand-700 text-lg tnum">$${o.price.toLocaleString("es")}</p>` : `<p class="text-sm text-ink-soft">Precio por definir</p>`}
              <p class="text-xs text-ink-soft mt-1">Actualizado ${formatDate(o.updatedAt)}</p>
            </div>
          </div>
          ${stepper(o.status)}
          ${o.notes ? `<p class="mt-4 text-sm bg-brand-50 border border-brand-100 rounded-xl px-4 py-3"><span class="font-semibold">Nota del equipo:</span> ${escapeHtml(o.notes)}</p>` : ""}
        </article>`;
    }

    function quoteCard(q: Quote) {
      return `
        <article class="bg-white rounded-2xl border border-brand-100 p-5 flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm">${escapeHtml(q.description)}</p>
            <p class="text-xs text-ink-soft mt-1">Material: ${escapeHtml(q.material)} · ${formatDate(q.createdAt)}</p>
            ${q.adminNotes ? `<p class="text-xs mt-2 bg-brand-50 border border-brand-100 rounded-lg px-3 py-2"><span class="font-semibold">Respuesta:</span> ${escapeHtml(q.adminNotes)}</p>` : ""}
            ${q.fromDesign ? `<a class="block text-sm text-brand-700 underline mt-3" href="/cotizacion-diseno?id=${q.id}">Ver propuesta y precio ${q.confirmedPriceCop === null ? "orientativo" : "confirmado"}</a>` : ""}
          </div>
          <span class="shrink-0 px-3 py-1 rounded-full text-xs font-bold ${QUOTE_COLORS[q.status] ?? "bg-brand-100 text-brand-700"}">${escapeHtml(QUOTE_LABELS[q.status] ?? q.status)}</span>
        </article>`;
    }

    const ordersList = document.getElementById("orders-list")!;
    const quotesList = document.getElementById("quotes-list")!;

    try {
      const [orders, quotes] = await Promise.all([
        apiFetch<Order[]>("/api/orders"),
        apiFetch<Quote[]>("/api/quotes/mine"),
      ]);

      ordersList.innerHTML = orders.length
        ? orders.map(orderCard).join("")
        : `<div class="bg-brand-50 border border-brand-100 rounded-2xl p-8 text-center">
             <p class="text-ink-soft mb-3">Aún no tienes pedidos. Cuando una cotización se apruebe, aparecerá aquí.</p>
             <a href="/cotizar" class="text-brand-700 font-semibold hover:underline">Cotizar mi primera idea →</a>
           </div>`;

      quotesList.innerHTML = quotes.length
        ? quotes.map(quoteCard).join("")
        : `<p class="text-ink-soft">No has enviado cotizaciones todavía.</p>`;
    } catch {
      ordersList.innerHTML = `<p class="text-red-600">No pudimos cargar tus pedidos. Recarga la página.</p>`;
      quotesList.innerHTML = "";
    }
  </script>
</Layout>
