---
import Layout from "../../layouts/Layout.astro";
import AdminTabs from "../../components/AdminTabs.astro";
const fields = [
  ["timeoutSeconds", "Tiempo máximo por intento (segundos)", 30, 300, 1],
  ["maxAttempts", "Intentos máximos por propuesta", 1, 3, 1],
  ["maxProposalsPerConversation", "Propuestas máximas por conversación", 1, 20, 1],
  ["maxAttemptsPerUserDay", "Intentos reservados por usuario al día", 1, 100, 1],
  ["reservePerAttemptUsd", "Reserva estimada por intento (USD)", 0.001, 10, 0.001],
  ["conversationBudgetUsd", "Presupuesto de imágenes por conversación (USD)", 0.001, 100, 0.001],
];
---
<Layout title="Admin - Propuestas visuales">
  <section class="max-w-5xl mx-auto px-4 py-10">
    <AdminTabs />
    <h1 class="font-display text-3xl font-extrabold mb-3">Propuestas visuales</h1>
    <p class="text-ink-soft mb-5">Selecciona el modelo de OpenRouter y controla las generaciones. La clave se configura únicamente en el servidor.</p>
    <p id="image-settings-status" role="status" aria-live="polite" class="mb-4">Cargando…</p>
    <form id="image-settings-form" class="hidden bg-white rounded-2xl border border-brand-100 p-6 grid sm:grid-cols-2 gap-5">
      <label class="flex items-center gap-2"><input name="enabled" type="checkbox" />Habilitar generación</label>
      <label class="flex items-center gap-2"><input name="supportsEditing" type="checkbox" />El modelo admite imágenes de referencia</label>
      <label class="font-semibold text-sm">Identificador del modelo
        <input name="model" maxlength="150" placeholder="proveedor/modelo" class="block w-full border border-brand-200 rounded-xl px-3 py-2 mt-1" />
      </label>
      <label class="font-semibold text-sm">Resolución
        <select name="resolution" class="block w-full border border-brand-200 rounded-xl px-3 py-2 mt-1">
          <option>512</option><option>768</option><option>1K</option><option>1.5K</option><option>2K</option>
        </select>
      </label>
      {fields.map(([name,label,min,max,step]) => <label class="font-semibold text-sm">{label}
        <input name={String(name)} type="number" min={Number(min)} max={Number(max)} step={Number(step)} required class="block w-full border border-brand-200 rounded-xl px-3 py-2 mt-1" />
      </label>)}
      <p class="sm:col-span-2 text-sm text-ink-soft">Verifica que el modelo admita PNG, la resolución elegida y, si habilitas edición, referencias base64. La reserva cubre los intentos previstos y se conserva ante fallos de resultado incierto. Es un límite interno estimado, no un tope garantizado del proveedor: configura también el límite de gasto de la clave en OpenRouter.</p>
      <fieldset class="sm:col-span-2 border rounded-xl p-4 space-y-3">
        <legend class="font-bold">Modelos por tarea</legend>
        <label><input name="routing.enabled" type="checkbox" /> Activar selección automática por tarea</label>
        <p class="text-sm">Borrador para ideas simples; detalle para varias tintas o referencias; edición para modificar una propuesta anterior. Los valores de reserva son límites internos estimados, no tarifas del proveedor.</p>
        {[["draft", "Borrador"], ["detailed", "Detalle"], ["edit", "Edición"]].map(([key, label]) => <fieldset class="border rounded p-3 grid gap-2">
          <legend>{label}</legend>
          <label>Modelo <input name={`routing.${key}.model`} required maxlength="150" class="border rounded w-full p-2" /></label>
          <label>Resolución <select name={`routing.${key}.resolution`} class="border p-2"><option>512</option><option>768</option><option>1K</option><option>1.5K</option><option>2K</option></select></label>
          <label>Reserva USD por intento <input name={`routing.${key}.reservePerAttemptUsd`} type="number" required min="0.001" max="10" step="0.001" class="border p-2" /></label>
          <label><input name={`routing.${key}.supportsEditing`} type="checkbox" /> Admite referencias</label>
        </fieldset>)}
      </fieldset>
      <div class="sm:col-span-2 flex gap-3">
        <button id="save-image-settings" class="rounded-full bg-brand-600 text-white font-bold px-6 py-3">Guardar nueva versión</button>
        <button id="reload-image-settings" type="button" class="rounded-full border border-brand-200 px-6 py-3">Recargar</button>
      </div>
    </form>
    <section class="mt-8"><h2 class="text-xl font-bold mb-3">Historial de configuración</h2><div id="image-settings-history" class="text-sm"></div></section>
    <section class="mt-8"><h2 class="text-xl font-bold mb-3">Últimas generaciones</h2><p class="text-sm text-ink-soft mb-3">Los valores de consumo no reportados se muestran como desconocidos.</p><div id="image-usage" class="overflow-x-auto"></div></section>
  </section>
  <script>
    import "../../lib/visual-settings";
  </script>
</Layout>
