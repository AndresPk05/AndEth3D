---
import Layout from "../../layouts/Layout.astro";
import AdminTabs from "../../components/AdminTabs.astro";
---

<Layout title="Admin — Cotizaciones">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <AdminTabs />
    <h1 class="font-display text-3xl font-extrabold mb-6">Cotizaciones</h1>
    <div id="quotes-list" class="space-y-4">
      <p class="text-ink-soft">Cargando…</p>
    </div>
  </section>

  <script>
    import { apiFetch, fileUrl, requireAuth } from "../../lib/api";

    requireAuth("Admin");

    interface Quote {
      id: number;
      userName: string;
      userEmail: string;
      description: string;
      material: string;
      referenceFileUrl: string | null;
      status: string;
      adminNotes: string | null;
      createdAt: string;
    }

    const LABELS: Record<string, string> = {
      Pending: "Pendiente",
      Quoted: "Cotizada",
      Converted: "En pedido",
      Rejected: "Rechazada",
    };
    const COLORS: Record<string, string> = {
      Pending: "bg-amber-100 text-amber-800",
      Quoted: "bg-blue-100 text-blue-800",
      Converted: "bg-green-100 text-green-800",
      Rejected: "bg-red-100 text-red-700",
    };

    const container = document.getElementById("quotes-list")!;
    let quotes: Quote[] = [];

    function formatDate(iso: string) {
      return new Date(iso).toLocaleDateString("es", { day: "numeric", month: "short", year: "numeric" });
    }

    function render() {
      container.innerHTML = quotes.length
        ? quotes.map((q) => `
          <article class="bg-white rounded-2xl border border-brand-100 p-5" data-id="${q.id}">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0 max-w-2xl">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="font-display font-bold">#${q.id} — ${q.userName}</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold ${COLORS[q.status]}">${LABELS[q.status]}</span>
                </div>
                <p class="text-sm mt-1">${q.description}</p>
                <p class="text-xs text-ink-soft mt-1">
                  ${q.userEmail} · Material: ${q.material} · ${formatDate(q.createdAt)}
                  ${q.referenceFileUrl ? ` · <a href="${fileUrl(q.referenceFileUrl)}" target="_blank" class="text-brand-700 font-semibold hover:underline">Ver archivo</a>` : ""}
                </p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 mt-4">
              <input type="text" placeholder="Respuesta al cliente (notas)" value="${q.adminNotes ?? ""}"
                class="notes-input flex-1 min-w-52 px-3 py-2 rounded-lg border border-brand-200 text-sm" />
              <button data-status="Quoted" class="status-btn px-3 py-2 rounded-full bg-blue-600 text-white text-xs font-bold hover:bg-blue-700 transition">Marcar cotizada</button>
              <button data-status="Rejected" class="status-btn px-3 py-2 rounded-full bg-red-100 text-red-700 text-xs font-bold hover:bg-red-200 transition">Rechazar</button>
              ${q.status !== "Converted" ? `
                <input type="text" placeholder="Título del pedido" class="title-input w-44 px-3 py-2 rounded-lg border border-brand-200 text-sm" />
                <input type="number" min="0" step="0.01" placeholder="Precio" class="price-input w-24 px-3 py-2 rounded-lg border border-brand-200 text-sm" />
                <button class="convert-btn px-4 py-2 rounded-full bg-brand-600 text-white text-xs font-bold hover:bg-brand-700 transition">Convertir en pedido</button>` : ""}
            </div>
            <p class="feedback hidden text-xs mt-2 font-semibold"></p>
          </article>`).join("")
        : `<p class="text-ink-soft">No hay cotizaciones todavía.</p>`;

      container.querySelectorAll<HTMLElement>("article").forEach((card) => {
        const id = Number(card.dataset.id);
        const notes = () => (card.querySelector(".notes-input") as HTMLInputElement).value;
        const feedback = card.querySelector(".feedback") as HTMLElement;

        card.querySelectorAll(".status-btn").forEach((btn) =>
          btn.addEventListener("click", async () => {
            try {
              await apiFetch(`/api/quotes/${id}`, {
                method: "PUT",
                body: JSON.stringify({ status: (btn as HTMLElement).dataset.status, adminNotes: notes() }),
              });
              await reload();
            } catch (err) {
              feedback.textContent = (err as Error).message;
              feedback.className = "feedback text-xs mt-2 font-semibold text-red-600";
            }
          })
        );

        card.querySelector(".convert-btn")?.addEventListener("click", async () => {
          const title = (card.querySelector(".title-input") as HTMLInputElement).value;
          const priceRaw = (card.querySelector(".price-input") as HTMLInputElement).value;
          try {
            await apiFetch(`/api/quotes/${id}`, {
              method: "PUT",
              body: JSON.stringify({ status: "Quoted", adminNotes: notes() }),
            });
            await apiFetch(`/api/quotes/${id}/convert`, {
              method: "POST",
              body: JSON.stringify({ title, price: priceRaw ? Number(priceRaw) : null, notes: null }),
            });
            await reload();
          } catch (err) {
            feedback.textContent = (err as Error).message;
            feedback.className = "feedback text-xs mt-2 font-semibold text-red-600";
          }
        });
      });
    }

    async function reload() {
      quotes = await apiFetch<Quote[]>("/api/quotes");
      render();
    }

    try {
      await reload();
    } catch (err) {
      container.innerHTML = `<p class="text-red-600">${(err as Error).message}</p>`;
    }
  </script>
</Layout>
