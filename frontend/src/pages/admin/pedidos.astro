---
import Layout from "../../layouts/Layout.astro";
import AdminTabs from "../../components/AdminTabs.astro";
---

<Layout title="Admin — Pedidos">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <AdminTabs />
    <h1 class="font-display text-3xl font-extrabold mb-6">Pedidos</h1>
    <div id="orders-table" class="space-y-4">
      <p class="text-ink-soft">Cargando…</p>
    </div>
  </section>

  <script>
    import { escapeHtml, apiFetch, requireAuth } from "../../lib/api";

    requireAuth("Admin");

    interface Order {
      id: number;
      userName: string;
      userEmail: string;
      title: string;
      description: string;
      price: number | null;
      status: string;
      notes: string | null;
      createdAt: string;
      updatedAt: string;
    }

    const NEXT: Record<string, string[]> = {
      Pending: ["Pending", "InQueue", "Cancelled"], InQueue: ["InQueue", "Printing", "Cancelled"],
      Printing: ["Printing", "Finished", "Cancelled"], Finished: ["Finished", "Delivered", "Cancelled"],
      Delivered: ["Delivered"], Cancelled: ["Cancelled"]
    };
    const LABELS: Record<string, string> = {
      Pending: "Recibido",
      InQueue: "En cola",
      Printing: "Imprimiendo",
      Finished: "Terminado",
      Delivered: "Entregado",
      Cancelled: "Cancelado",
    };
    const COLORS: Record<string, string> = {
      Pending: "bg-amber-100 text-amber-800",
      InQueue: "bg-blue-100 text-blue-800",
      Printing: "bg-brand-100 text-brand-800",
      Finished: "bg-green-100 text-green-800",
      Delivered: "bg-emerald-100 text-emerald-800",
      Cancelled: "bg-red-100 text-red-700",
    };

    const container = document.getElementById("orders-table")!;
    let orders: Order[] = [];

    function formatDate(iso: string) {
      return new Date(iso).toLocaleDateString("es", { day: "numeric", month: "short" });
    }

    function render() {
      container.innerHTML = orders.length
        ? orders.map((o) => `
          <article class="bg-white rounded-2xl border border-brand-100 p-5" data-id="${o.id}">
            <a href="/admin/operacion?orderId=${o.id}" class="block text-brand-700 underline text-sm mb-3">Registrar o consultar producción real</a>
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="font-display font-bold">#${o.id} — ${escapeHtml(o.title)}</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold ${COLORS[o.status]}">${LABELS[o.status]}</span>
                </div>
                <p class="text-sm text-ink-soft mt-1">${escapeHtml(o.description)}</p>
                <p class="text-xs text-ink-soft mt-1">Cliente: <span class="font-semibold">${escapeHtml(o.userName)}</span> (${escapeHtml(o.userEmail)}) · Creado ${formatDate(o.createdAt)}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <select class="status-select px-3 py-2 rounded-lg border border-brand-200 text-sm bg-white">
                  ${(NEXT[o.status] ?? []).map((s) => `<option value="${s}" ${s === o.status ? "selected" : ""}>${LABELS[s]}</option>`).join("")}
                </select>
                <input type="number" min="0" step="0.01" placeholder="Precio" value="${o.price ?? ""}"
                  class="price-input w-28 px-3 py-2 rounded-lg border border-brand-200 text-sm" />
                <input type="text" placeholder="Nota para el cliente" value="${escapeHtml(o.notes ?? "")}"
                  class="notes-input w-52 px-3 py-2 rounded-lg border border-brand-200 text-sm" />
                <button class="save-btn px-4 py-2 rounded-full bg-brand-600 text-white text-sm font-semibold hover:bg-brand-700 transition">Guardar</button>
              </div>
            </div>
            <p class="feedback hidden text-xs mt-2 font-semibold"></p>
          </article>`).join("")
        : `<p class="text-ink-soft">No hay pedidos todavía. Convierte una cotización desde la pestaña Cotizaciones.</p>`;

      container.querySelectorAll<HTMLElement>("article").forEach((card) => {
        card.querySelector(".save-btn")!.addEventListener("click", async () => {
          const id = Number(card.dataset.id);
          const status = (card.querySelector(".status-select") as HTMLSelectElement).value;
          const priceRaw = (card.querySelector(".price-input") as HTMLInputElement).value;
          const notes = (card.querySelector(".notes-input") as HTMLInputElement).value;
          const feedback = card.querySelector(".feedback") as HTMLElement;
          try {
            await apiFetch(`/api/admin/orders/${id}/status`, {
              method: "PUT",
              body: JSON.stringify({ status, notes, price: priceRaw ? Number(priceRaw) : null }),
            });
            const order = orders.find((o) => o.id === id)!;
            order.status = status;
            order.notes = notes;
            order.price = priceRaw ? Number(priceRaw) : order.price;
            render();
          } catch (err) {
            feedback.textContent = (err as Error).message;
            feedback.className = "feedback text-xs mt-2 font-semibold text-red-600";
          }
        });
      });
    }

    try {
      orders = await apiFetch<Order[]>("/api/admin/orders");
      render();
    } catch (err) {
      container.innerHTML = `<p class="text-red-600">${escapeHtml((err as Error).message)}</p>`;
    }
  </script>
</Layout>
