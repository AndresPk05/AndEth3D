---
import Layout from "../../layouts/Layout.astro";
import AdminTabs from "../../components/AdminTabs.astro";
---

<Layout title="Admin — Galería">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <AdminTabs />
    <h1 class="font-display text-3xl font-extrabold mb-6">Galería</h1>

    <div class="bg-white rounded-2xl border border-brand-100 p-6 mb-8">
      <h2 class="font-display font-bold mb-4" id="form-title">Agregar nuevo trabajo</h2>
      <form id="gallery-form" class="grid sm:grid-cols-2 gap-4">
        <input type="hidden" id="item-id" />
        <div>
          <label class="block text-sm font-semibold mb-1" for="title">Título *</label>
          <input id="title" required class="w-full px-4 py-2.5 rounded-xl border border-brand-200 text-sm focus:border-brand-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="category">Categoría *</label>
          <input id="category" required placeholder="Figuras, Hogar, Accesorios…" class="w-full px-4 py-2.5 rounded-xl border border-brand-200 text-sm focus:border-brand-500 outline-none" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-sm font-semibold mb-1" for="description">Descripción *</label>
          <textarea id="description" required rows="2" class="w-full px-4 py-2.5 rounded-xl border border-brand-200 text-sm focus:border-brand-500 outline-none resize-y"></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="material">Material</label>
          <input id="material" placeholder="PLA, PETG…" class="w-full px-4 py-2.5 rounded-xl border border-brand-200 text-sm focus:border-brand-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1" for="image">Foto <span id="image-required">*</span></label>
          <input id="image" type="file" accept=".png,.jpg,.jpeg,.webp,.gif"
            class="w-full text-sm file:mr-3 file:px-4 file:py-2 file:rounded-full file:border-0 file:bg-brand-50 file:text-brand-700 file:font-semibold hover:file:bg-brand-100 file:cursor-pointer" />
        </div>
        <div class="sm:col-span-2 flex items-center gap-3">
          <button type="submit" id="submit-btn" class="px-6 py-2.5 rounded-full bg-brand-600 text-white font-semibold hover:bg-brand-700 transition">Guardar</button>
          <button type="button" id="cancel-edit" class="hidden px-6 py-2.5 rounded-full border-2 border-brand-200 text-brand-700 font-semibold hover:bg-brand-50 transition">Cancelar edición</button>
          <p id="form-error" class="hidden text-sm text-red-600 font-medium"></p>
        </div>
      </form>
    </div>

    <div id="items-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <p class="text-ink-soft">Cargando…</p>
    </div>
  </section>

  <script>
    import { apiFetch, fileUrl, requireAuth } from "../../lib/api";

    requireAuth("Admin");

    interface GalleryItem {
      id: number;
      title: string;
      description: string;
      category: string;
      material: string;
      imageUrl: string;
    }

    const grid = document.getElementById("items-grid")!;
    const form = document.getElementById("gallery-form") as HTMLFormElement;
    const formError = document.getElementById("form-error")!;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const cancelEdit = document.getElementById("cancel-edit") as HTMLButtonElement;
    let items: GalleryItem[] = [];

    function resetForm() {
      form.reset();
      (document.getElementById("item-id") as HTMLInputElement).value = "";
      document.getElementById("form-title")!.textContent = "Agregar nuevo trabajo";
      document.getElementById("image-required")!.textContent = "*";
      (document.getElementById("image") as HTMLInputElement).required = true;
      cancelEdit.classList.add("hidden");
    }

    function render() {
      grid.innerHTML = items.length
        ? items.map((item) => `
          <article class="bg-white rounded-2xl overflow-hidden border border-brand-100" data-id="${item.id}">
            <div class="aspect-[4/3] bg-brand-50">
              ${item.imageUrl
                ? `<img src="${fileUrl(item.imageUrl)}" alt="${item.title}" class="w-full h-full object-cover" />`
                : `<div class="w-full h-full flex items-center justify-center text-brand-300 text-sm">Sin imagen</div>`}
            </div>
            <div class="p-4">
              <span class="text-xs font-semibold text-brand-600 uppercase">${item.category}</span>
              <h3 class="font-display font-bold">${item.title}</h3>
              <p class="text-sm text-ink-soft line-clamp-2 mt-1">${item.description}</p>
              <div class="flex gap-2 mt-3">
                <button class="edit-btn flex-1 py-2 rounded-full border border-brand-200 text-brand-700 text-sm font-semibold hover:bg-brand-50 transition">Editar</button>
                <button class="delete-btn flex-1 py-2 rounded-full bg-red-50 text-red-600 text-sm font-semibold hover:bg-red-100 transition">Eliminar</button>
              </div>
            </div>
          </article>`).join("")
        : `<p class="text-ink-soft col-span-full">No hay trabajos en la galería.</p>`;

      grid.querySelectorAll<HTMLElement>("article").forEach((card) => {
        const id = Number(card.dataset.id);
        card.querySelector(".edit-btn")!.addEventListener("click", () => {
          const item = items.find((i) => i.id === id)!;
          (document.getElementById("item-id") as HTMLInputElement).value = String(id);
          (document.getElementById("title") as HTMLInputElement).value = item.title;
          (document.getElementById("category") as HTMLInputElement).value = item.category;
          (document.getElementById("description") as HTMLTextAreaElement).value = item.description;
          (document.getElementById("material") as HTMLInputElement).value = item.material;
          const imageInput = document.getElementById("image") as HTMLInputElement;
          imageInput.required = false;
          document.getElementById("image-required")!.textContent = "(opcional, dejar vacío para conservar)";
          document.getElementById("form-title")!.textContent = `Editando: ${item.title}`;
          cancelEdit.classList.remove("hidden");
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        card.querySelector(".delete-btn")!.addEventListener("click", async () => {
          if (!confirm("¿Eliminar este trabajo de la galería?")) return;
          try {
            await apiFetch(`/api/gallery/${id}`, { method: "DELETE" });
            await reload();
          } catch (err) {
            alert((err as Error).message);
          }
        });
      });
    }

    async function reload() {
      items = await apiFetch<GalleryItem[]>("/api/gallery");
      render();
    }

    cancelEdit.addEventListener("click", resetForm);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      formError.classList.add("hidden");
      submitBtn.disabled = true;
      submitBtn.textContent = "Guardando…";
      try {
        const id = (document.getElementById("item-id") as HTMLInputElement).value;
        const data = new FormData();
        data.append("title", (document.getElementById("title") as HTMLInputElement).value);
        data.append("category", (document.getElementById("category") as HTMLInputElement).value);
        data.append("description", (document.getElementById("description") as HTMLTextAreaElement).value);
        data.append("material", (document.getElementById("material") as HTMLInputElement).value);
        const image = (document.getElementById("image") as HTMLInputElement).files?.[0];
        if (image) data.append("image", image);

        if (id) {
          await apiFetch(`/api/gallery/${id}`, { method: "PUT", body: data });
        } else {
          if (!image) throw new Error("La foto es obligatoria para un nuevo trabajo.");
          await apiFetch("/api/gallery", { method: "POST", body: data });
        }
        resetForm();
        await reload();
      } catch (err) {
        formError.textContent = (err as Error).message;
        formError.classList.remove("hidden");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Guardar";
      }
    });

    (document.getElementById("image") as HTMLInputElement).required = true;

    try {
      await reload();
    } catch (err) {
      grid.innerHTML = `<p class="text-red-600">${(err as Error).message}</p>`;
    }
  </script>
</Layout>
